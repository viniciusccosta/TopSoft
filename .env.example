LOGGING_LEVEL=DEBUG
STEPS_API_DEBUG=1000
SERVICE=topsoft
ACCOUNT=activitysoft_api_key
MIN_INTERVAL=1
MAX_INTERVAL=1440
DEFAULT_INTERVAL=1
API_BASE_URL=https://siga.activesoft.com.br/api/v0/
SETTINGS_FILE=./settings.json
MAX_AT_ONCE=1000
MAX_PER_SECOND=5

# Log rotation settings to prevent huge log files
# MAX_LOG_SIZE_MB: Maximum size of each log file in MB before rotation
MAX_LOG_SIZE_MB=50
# LOG_BACKUP_COUNT: Number of backup log files to keep (topsoft.log.1, topsoft.log.2, etc.)
LOG_BACKUP_COUNT=5

# Performance tuning parameters
# FILE_READ_CHUNK_SIZE: Number of lines to process before showing progress (higher = less frequent progress updates but slightly faster)
# Recommended: 5000-20000 for most systems, 50000+ for high-end systems with large files
FILE_READ_CHUNK_SIZE=10000

# DB_BATCH_SIZE: Number of records to process in each database batch (higher = faster but more memory usage)
# Recommended: 2000-10000 for most systems, 20000+ for high-end systems with lots of RAM
DB_BATCH_SIZE=5000