LOGGING_LEVEL=DEBUG
STEPS_API_DEBUG=1000
SERVICE=topsoft
ACCOUNT=activitysoft_api_key
MIN_INTERVAL=1
MAX_INTERVAL=1440
DEFAULT_INTERVAL=1
API_BASE_URL=https://siga.activesoft.com.br/api/v0/
SETTINGS_FILE=./settings.json
MAX_AT_ONCE=1000
MAX_PER_SECOND=5

# Performance Tuning Configuration Examples
# Copy this file to .env and adjust values based on your hardware

# For LOW-END systems (4GB RAM, slower CPU)
# FILE_READ_CHUNK_SIZE=5000
# DB_BATCH_SIZE=2000

# For MID-RANGE systems (8GB RAM, modern CPU) - DEFAULT
FILE_READ_CHUNK_SIZE=10000
DB_BATCH_SIZE=5000

# For HIGH-END systems (16GB+ RAM, fast CPU, SSD storage)
# FILE_READ_CHUNK_SIZE=25000
# DB_BATCH_SIZE=10000

# For VERY LARGE files (1M+ lines) on powerful systems
# FILE_READ_CHUNK_SIZE=50000
# DB_BATCH_SIZE=20000er of records to process in each database batch (higher = faster but more memory usage)
# Recommended: 2000-10000 for most systems, 20000+ for high-end systems with lots of RAM
DB_BATCH_SIZE=5000